{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "research-pro/authority-registry.schema.json",
  "title": "Research Pro Authority Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "authorities"],
  "properties": {
    "version": {"const": "1.0"},
    "authorities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "domains"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "name": {"type": "string", "minLength": 1},
          "domains": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
        }
      }
    }
  }
}
