# research-pro env example
# Copy to ~/.config/research-pro/.env and fill values.
# chmod 600 ~/.config/research-pro/.env
#
# Minimum: set ANY ONE of TAVILY_API_KEY / XAI_API_KEY / OPENROUTER_API_KEY
# (or rely on host-native web_search without these scripts).

TAVILY_API_KEY=
XAI_API_KEY=
OPENROUTER_API_KEY=

# Optional
# Jev pre-judgment layer — either name works, same key (references/jev-judge.md)
# TYPESAFE_API_KEY=
# JEV_API_KEY=
# FIRECRAWL_API_KEY=
# YOUTUBE_API_KEY=
# DATAFORSEO_LOGIN=
# DATAFORSEO_PASSWORD=
# REDDIT_SESSION=

# Behavior (optional)
# RESEARCH_PRO_JEV=off                # disable the Jev pre-judgment layer
# RESEARCH_PRO_TRUST_HOST_ENV=0
# RESEARCH_PRO_LOAD_CWD_ENV=0
# RESEARCH_PRO_HOME=
# RESEARCH_PRO_ENV_FILE=
