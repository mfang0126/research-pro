{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "research-pro/search-event.schema.json",
  "title": "Research Pro Search Event",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_id", "run_id", "contract_hash", "scope_key", "sub_q", "round", "query", "requested_hint", "requested_tool", "actual_tool", "fallback_chain", "status", "degraded", "degrade_reason", "failure_class", "evidence_capability", "requested_url", "returned_url", "final_url", "identity_status", "content_type", "content_sha256", "result_count", "raw_path", "cache_key", "cache_hit", "cache_stale", "retrieval_status", "trace_coverage", "source_id", "canonical_source_id", "parent_event_id", "discovery_evidence_id", "authority_registry_id", "platform", "account_or_author", "published_at", "sample_window", "sample_basis", "selection_bias", "final_url_status", "independence_group", "evidence_ids", "provider_usage", "provider_cost", "usage_status", "elapsed_ms", "captured_at"],
  "properties": {
    "event_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "contract_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "scope_key": {"type": "string", "minLength": 1},
    "sub_q": {"type": "string", "minLength": 1},
    "round": {"type": "integer", "minimum": 0},
    "query": {"type": "string", "minLength": 1},
    "requested_hint": {"type": ["string", "null"]},
    "requested_tool": {"type": "string", "minLength": 1},
    "actual_tool": {"type": "string", "minLength": 1},
    "fallback_chain": {"type": "array", "items": {"type": "string"}},
    "status": {"type": "string", "minLength": 1},
    "degraded": {"type": "boolean"},
    "degrade_reason": {"type": ["string", "null"]},
    "failure_class": {"type": ["string", "null"]},
    "evidence_capability": {"enum": ["none", "discovery_only", "official_discovery_only", "page_body", "preview_extracted", "social_lead_only", "evidence_grade"]},
    "requested_url": {"type": ["string", "null"]},
    "returned_url": {"type": ["string", "null"]},
    "final_url": {"type": ["string", "null"]},
    "identity_status": {"enum": ["clean", "verified", "failed", "unverified"]},
    "content_type": {"type": ["string", "null"]},
    "content_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "result_count": {"type": ["integer", "null"], "minimum": 0},
    "raw_path": {"type": ["string", "null"]},
    "cache_key": {"type": ["string", "null"]},
    "cache_hit": {"type": "boolean"},
    "cache_stale": {"type": "boolean"},
    "retrieval_status": {"type": "string", "minLength": 1},
    "trace_coverage": {"type": "string", "minLength": 1},
    "source_id": {"type": ["string", "null"]},
    "canonical_source_id": {"type": ["string", "null"]},
    "parent_event_id": {"type": ["string", "null"]},
    "discovery_evidence_id": {"type": ["string", "null"]},
    "authority_registry_id": {"type": ["string", "null"]},
    "platform": {"type": ["string", "null"]},
    "account_or_author": {"type": ["string", "null"]},
    "published_at": {"type": ["string", "null"]},
    "sample_window": {"type": ["string", "null"]},
    "sample_basis": {"type": ["string", "null"]},
    "selection_bias": {"type": ["string", "null"]},
    "final_url_status": {"enum": ["clean", "unsafe_scheme", "credential_present", "loopback", "private", "malformed"]},
    "independence_group": {"type": ["string", "null"]},
    "evidence_ids": {"type": "array", "items": {"type": "string"}},
    "provider_usage": {"type": ["object", "null"]},
    "provider_cost": {"type": ["number", "null"], "minimum": 0},
    "usage_status": {"enum": ["known", "unknown", "partial"]},
    "elapsed_ms": {"type": ["integer", "null"], "minimum": 0},
    "captured_at": {"type": "string", "minLength": 1}
  }
}
